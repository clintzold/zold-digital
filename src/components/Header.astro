---
import logo from '../assets/images/logo-trim.png'
---
<header>
  <div class="container">
    <nav>
      <a class="nav-brand" href="#"><img src={logo.src} alt=""></a>
      <div class="hamburger">
        <span class="bar bar-one"></span>
        <span class="bar bar-two"></span>
        <span class="bar bar-three"></span>
      </div>
      <ul class="nav-menu">
        <li><a href="#">Home</a></li>
        <li><a href="#">Services</a></li>
        <li><a href="#">About</a></li>
        <li><a class="btn" href="#"><span>Call Clint</span></a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    position: fixed;
    width: 100%;
    padding: 0;
    z-index: 1000;
    background: rgb(from var(--color-surface) r g b / 0.7);
  }

  nav {
    font-weight: 500;
    padding: 0 1rem;
    height: 100px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-brand img {
    width: 175px;
    height: auto;
  }
  .nav-menu {
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    transition: transform 0.3s ease;
  }

  .hamburger {
    display: none;
    width: 40px;
    border: 2px solid transparent;
    padding: 0;
    cursor: pointer;
  }

  .bar {
    width: 100%;
    height: 4px;
    border-radius: 2px;
    background: var(--color-primary-light);
    transition: all 0.3s ease;
  }

  .bar-two.active {
    opacity: 0;
  }

  .bar-one.active {
    transform: rotate(-45deg) translate(-7px, 10px);
  }
  .bar-three.active {
    transform: rotate(45deg) translate(-7px, -10px);
  }

  li {
    transition: color 0.5s ease;
  }
  li:hover {
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .hamburger {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .nav-menu {
      color: var(--color-surface);
      padding: 100px 0;
      height: 100%;
      width: 100%;
      position: fixed;
      top: 100px;
      left: -100%;
      flex-direction: column;
      align-items: center;
      background: var(--color-primary-dark);
    }

    .nav-menu.active {
      transform: translateX(100%);
    }
  }
</style>

<script>
  const hamburger = document.querySelector('.hamburger')
  const navMenu = document.querySelector('.nav-menu')
  const bars = document.querySelectorAll('.bar')

  hamburger.addEventListener('click', toggleMenu)

  function toggleMenu() {
    hamburger.classList.toggle('active')
    navMenu.classList.toggle('active')
    bars.forEach(bar => {
      bar.classList.toggle('active')
    })
  }
</script>
