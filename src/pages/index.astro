---
import aboutImg from '../assets/images/IMG_3487.JPG'
import heroBg from '../assets/images/frozen-lake.jpg'
import logo from '../assets/images/logo-trim.png'
const bgUrl = `url(${heroBg.src})`
import BaseLayout from '../layouts/BaseLayout.astro'
import Footer from '../components/Footer.astro'
---

<BaseLayout pageTitle="Home | Zold Digital">
  <section id="hero-section" class="hero-section">
    <div class="container">
      <div class="hero-grid">
        <img class="img-fluid" src={logo.src} alt="">
        <div class="hero-card">
          <div class="hero-text">
            <h1>Websites built for the <span>North</span></h1>
            <p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Architecto natus itaque veniam animi dicta. Eum exercitationem qui ex eius quibusdam.</p>
            <a class="btn"href="#">Contact Me</a>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-bg"></div>
  </section>
  <section id="about" class="about-section">
    <div class="container">
      <div class="about-grid">
        <div class="about-card">
          <h2>Who am I?</h2>
          <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Reprehenderit adipisci inventore a repellendus quis labore id odio dolorum esse. Inventore vitae ullam et harum temporibus.</p>
          <a href="#" class="btn">Read My Story</a>
        </div>
        <img class="about-image" src={aboutImg.src} alt="">
      </div>
    </div>
  </section>
  <section class="services-section">
    <div class="container">
      <h2>Services</h2>
      <div class="services-grid">
        <div class="service-card">
          <div class="card-text">
            <h3>Web Design & Development</h3>
            <p>Lorem ipsum dolor, sit amet consectetur adipisicing elit. Libero, commodi.</p>
            <ul>
              <li>Lorem, ipsum dolor.</li>
              <li>Lorem, ipsum dolor.</li>
              <li>Lorem ipsum dolor sit.</li>
              <li>Lorem ipsum dolor sit amet.</li>
            </ul>
          </div>
        </div>
        <div class="service-card">
          <div class="card-text">
            <h3>Marketing & SEO</h3>
            <p>Lorem ipsum dolor, sit amet consectetur adipisicing elit. Libero, commodi.</p>
            <ul>
              <li>Lorem, ipsum dolor sit.</li>
              <li>Lorem, ipsum dolor sit.</li>
              <li>Lorem ipsum dolor sit.</li>
              <li>Lorem ipsum dolor sit amet.</li>
            </ul>
          </div>
        </div>
        <div class="service-card">
          <div class="card-text">
            <h3>Social Media Managament</h3>
            <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit. Cupiditate, vitae.</p>
            <ul>
              <li>Lorem, ipsum dolor.</li>
              <li>Lorem, ipsum dolor.</li>
              <li>Lorem ipsum dolor sit.</li>
              <li>Lorem ipsum dolor sit amet.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="testimonials">
    <div class="container">
      <h2>Who we've helped</h2>
    </div>
  </section>
  <section class="contact">
    <div class="container">
      <h2>Contact</h2>
    </div>
  </section>
  <Footer/>
</BaseLayout>

<style define:vars={{bgUrl}}>
.hero-section {
  position: relative;
  background: rgb(from var(--color-surface) r g b / 0.8);
  padding: 450px 0 400px 0;
}

.hero-card {
  padding: 1rem;
}

.hero-card p {
  font-weight: 600;
  color: var(--color-text-muted);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  place-items: center;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  background-image: var(--bgUrl);
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  z-index: -1;
}

.about-image {
  width: clamp(20%, 300px, 50%);
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  object-fit: cover;
  object-position: center;
}

h1 span {
  color: var(--color-text-muted);
  font-style: italic;
}

.about-section {
  background: var(--color-primary-light);
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  place-items: center;
}

.about-card {
  padding: 2rem 1rem 1rem 3rem;
  border-bottom: 2px solid var(--color-surface);
  border-right: 2px solid var(--color-surface);
  color: var(--color-white);
}

.services-section {
  background: var(--color-primary-light);

}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  place-items: center;
  gap: 2rem;
}

.service-card {
  padding: 2rem;
  background: var(--color-white);
  box-shadow: 3px 5px 20px -15px rgba(128, 128, 128, 0.3);
  border: 4px solid var(--color-primary-light);
  border-radius: 5px;
  transform: skewX(-10deg);
}

.service-card .card-text {
  transform: skewX(10deg);
}

@media (max-width: 768px) {
  .hero-section {
    padding: 175px 0 150px 0;
  }
  .hero-grid, .about-grid {
    grid-template-columns: 1fr;
  }

  .about-grid {
    gap: 1rem;
  }

  .about-grid .about-image {
    grid-row: 1;
  }

  .services-grid {
    grid-template-columns: 1fr;
  }

  .service-card, .service-card .card-text {
    transform: skewX(0);
  }

  .container {
    padding: 0 1rem;
  }
}
</style>
